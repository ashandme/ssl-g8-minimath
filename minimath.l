%{
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <string.h>
#include "minimath.tab.h" // Header generated by Bison

extern int yylineno;
%}

%option noyywrap
%option yylineno

/* Regular Expression Definitions */
LETRA        [a-zA-Z]
DIGITO       [0-9]
LETRA_GRIEGA_SOLA (\xCE\xB1)
IDENTIFICADOR_COMUN ([a-zA-Z_][a-zA-Z0-9_]{0,15})
IDENTIFICADOR_LARGO  ([a-zA-Z_][a-zA-Z0-9_]{16,})

%%
"imprimir"  { return IMPRIMIR; }
"INICIO"    { return INICIO; }
"FIN"       { return FIN; }

{IDENTIFICADOR_LARGO} {
    fprintf(stderr, "Lexical Error: Identifier '%s' on line %d exceeds maximum length of 16 characters.\n",
            yytext, yylineno);
    return ERROR;
}

{LETRA_GRIEGA_SOLA} {
    yylval.sval = strdup(yytext);
    return ID;
}

{IDENTIFICADOR_COMUN} {
    yylval.sval = strdup(yytext);
    return ID;
}

{DIGITO}+ {
    yylval.ival = atoi(yytext);
    return CONSTANTE;
}

'[^'\n]*' {
    yytext[yyleng-1] = 0; // Remove trailing quote
    yylval.sval = strdup(yytext+1); // Copy content without leading quote
    return CADENA;
}

"="   { return ASIGNACION; }
"+"   { return SUMA; }
"*"   { return PRODUCTO; }
"/"   { return DIVISION; }
";"   { return PUNTOYCOMA; }
"("   { return PARENIZQUIERDO; }
")"   { return PARENDERECHO; }

[ \t\n]+      { /* espacio/tab/salto no hacer nada */ }

. {
    fprintf(stderr, "AL: no reconoce '%s' en la linea %d\n", yytext, yylineno);
    return ERROR;
}

%%
